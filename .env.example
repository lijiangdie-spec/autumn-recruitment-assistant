# All personal data is external by default. Set only if you want a custom location.
# AUTUMN_ASSISTANT_DATA_ROOT=C:\Users\you\AppData\Local\秋招助手

# Optional local source configuration.
# RECRUITMENT_IMPORT_DIRECTORY=C:\path\to\job-sheets
# RECRUITMENT_IMPORT_SHEET_NAME=岗位信息
# QQDOCS_DOCUMENT_URL=https://docs.qq.com/sheet/...?...tab=...
# QQDOCS_SOURCE_NAME=腾讯文档 · 岗位信息表
# QQDOCS_PROFILE_DIR=C:\Users\you\.autumn-recruitment\qqdocs-profile

# Optional agent executable overrides.
# CODEX_EXECUTABLE=codex
# CLAUDE_EXECUTABLE=claude

# Optional PDF tool overrides.
# XELATEX_EXECUTABLE=xelatex
# PDFINFO_EXECUTABLE=pdfinfo
# PDFTOTEXT_EXECUTABLE=pdftotext
# PDFTOPPM_EXECUTABLE=pdftoppm

# Public feed publisher (reads the database in SQLite read-only mode).
# RECRUITMENT_DB_PATH=C:\path\to\private\recruitment.db
# AUTUMN_ASSISTANT_FEED_OUTPUT=C:\path\to\public-repo\public-site\feed.json
